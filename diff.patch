-class _GlossyWavesPainter extends CustomPainter {
-  final Color accentColor;
-
-  _GlossyWavesPainter({required this.accentColor});
-
-  Paint? _paint1Cache;
-  Paint? _paint2Cache;
-  Paint? _paint3Cache;
-  Color? _lastAccentColor;
-  Rect? _lastRect;
-
-  @override
-  void paint(Canvas canvas, Size size) {
-    final rect = Rect.fromLTWH(0, 0, size.width, size.height);
-
-    if (_paint1Cache == null ||
-        _lastAccentColor != accentColor ||
-        _lastRect != rect) {
-      _lastAccentColor = accentColor;
-      _lastRect = rect;
-
-      _paint1Cache = Paint()
-        ..shader = LinearGradient(
-          colors: [
-            accentColor.withValues(alpha: 0.28),
-            accentColor.withValues(alpha: 0.0),
-          ],
-          begin: Alignment.topCenter,
-          end: Alignment.bottomCenter,
-        ).createShader(rect);
-
-      _paint2Cache = Paint()
-        ..shader = LinearGradient(
-          colors: [
-            Colors.white.withValues(alpha: 0.08),
-            Colors.white.withValues(alpha: 0.0),
-          ],
-          begin: Alignment.topLeft,
-          end: Alignment.bottomRight,
-        ).createShader(rect);
-
-      _paint3Cache = Paint()
-        ..shader = LinearGradient(
-          colors: [
-            accentColor.withValues(alpha: 0.15),
-            accentColor.withValues(alpha: 0.0),
-          ],
-          begin: Alignment.bottomLeft,
-          end: Alignment.topRight,
-        ).createShader(rect);
-    }
-
-    // Wave 1: Accent color glow wave
-    final path1 = Path();
-    path1.moveTo(0, size.height * 0.7);
-    path1.quadraticBezierTo(
-      size.width * 0.4,
-      size.height * 0.45,
-      size.width * 0.8,
-      size.height * 0.85,
-    );
-    path1.quadraticBezierTo(
-      size.width * 0.9,
-      size.height * 0.9,
-      size.width,
-      size.height * 0.6,
-    );
-    path1.lineTo(size.width, size.height);
-    path1.lineTo(0, size.height);
-    path1.close();
-    canvas.drawPath(path1, _paint1Cache!);
-
-    // Wave 2: Glossy white highlight wave
-    final path2 = Path();
-    path2.moveTo(0, size.height * 0.85);
-    path2.quadraticBezierTo(
-      size.width * 0.5,
-      size.height * 0.4,
-      size.width,
-      size.height * 0.75,
-    );
-    path2.lineTo(size.width, size.height);
-    path2.lineTo(0, size.height);
-    path2.close();
-    canvas.drawPath(path2, _paint2Cache!);
-
-    // Wave 3: Deep contrast wave
-    final path3 = Path();
-    path3.moveTo(size.width * 0.25, size.height);
-    path3.quadraticBezierTo(
-      size.width * 0.65,
-      size.height * 0.55,
-      size.width,
-      size.height * 0.85,
-    );
-    path3.lineTo(size.width, size.height);
-    path3.close();
-    canvas.drawPath(path3, _paint3Cache!);
-  }
-
-  @override
-  bool shouldRepaint(covariant _GlossyWavesPainter oldDelegate) =>
-      oldDelegate.accentColor != accentColor;
-}
